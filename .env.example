# Copy to .env and fill in. None of these are secrets: they are names, addresses and limits.
# Authentication uses `az login` (DefaultAzureCredential); never put keys or tokens in this file.

# ---- Azure AI Foundry ----
# Portal -> your project -> Overview -> Project endpoint
PROJECT_ENDPOINT=https://<your-account>.services.ai.azure.com/api/projects/<your-project>
# The agent created in Build -> Agents
AGENT_NAME=Codecompass-agent
# Deployment names from the portal (Models / Quota)
MODEL_DEPLOYMENT=gpt-5-mini
EMBEDDING_DEPLOYMENT=text-embedding-3-small

# ---- Server (FastAPI) ----
API_HOST=127.0.0.1
API_PORT=8000
WEB_ORIGIN=http://localhost:3000        # the only origin allowed by CORS
LOG_DB_PATH=logs/codecompass.db
MAX_QUESTION_CHARS=500
AGENT_TIMEOUT_SECONDS=90
QUEUE_WAIT_SECONDS=60                   # how long a request waits for the single agent slot
MAX_CONCURRENT_AGENT_CALLS=1
REPOS_FILE=repos.json                   # pinned repos and SHAs (shared with ingest/ingest.py)
PROMPTS_DIR=prompts

# ---- Web (Next.js) ----
# Browser-visible: only addresses, never credentials
NEXT_PUBLIC_API_URL=http://localhost:8000
