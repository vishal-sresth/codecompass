# Copy to .env and fill in. These are NOT secrets: they are names and addresses.
# Authentication uses `az login` (DefaultAzureCredential); never put keys in this file.

# Foundry project endpoint: portal -> your project -> Overview -> Project endpoint
PROJECT_ENDPOINT=https://<your-account>.services.ai.azure.com/api/projects/<your-project>
# The agent you created in Build -> Agents
AGENT_NAME=Codecompass-agent
# Deployment names from Models / Quota in the portal
MODEL_DEPLOYMENT=gpt-5-mini
EMBEDDING_DEPLOYMENT=text-embedding-3-small
